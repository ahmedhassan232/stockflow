# ─────────────────────────────────────────────────────────────
# StockFlow environment template.  Copy to `.env` and edit.
#   cp .env.example .env
# Never commit the real .env file. Every value below is a
# DEVELOPMENT placeholder and must be replaced in production.
# ─────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────
APP_ENV=development                 # development | test | production
APP_NAME=StockFlow
LOG_LEVEL=INFO
# Comma-separated explicit allowlist. Wildcards are rejected in production.
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# ── PostgreSQL ───────────────────────────────────────────────
# Cluster superuser: used ONLY by the container init script.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-superuser
POSTGRES_DB=stockflow
# Schema owner: used ONLY by Alembic migrations.
DB_OWNER_USER=stockflow_owner
DB_OWNER_PASSWORD=change-me-owner
# Runtime role: used by the API and workers. NOSUPERUSER + NOBYPASSRLS,
# so PostgreSQL Row Level Security always applies to it.
DB_APP_USER=stockflow_app
DB_APP_PASSWORD=change-me-app

DATABASE_URL=postgresql+psycopg://stockflow_app:change-me-app@postgres:5432/stockflow
MIGRATION_DATABASE_URL=postgresql+psycopg://stockflow_owner:change-me-owner@postgres:5432/stockflow
# Used by pytest only (database is created by the init script).
TEST_DATABASE_URL=postgresql+psycopg://stockflow_app:change-me-app@postgres:5432/stockflow_test
TEST_MIGRATION_DATABASE_URL=postgresql+psycopg://stockflow_owner:change-me-owner@postgres:5432/stockflow_test
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

# ── Redis / Celery ───────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── Email (Mailpit in development) ───────────────────────────
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=no-reply@stockflow.local
# Real providers: port 587 + STARTTLS + login
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false

# ── Frontend (build-time, PUBLIC — never put secrets here) ───
VITE_API_BASE_URL=/api/v1

# ── Authentication ───────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-generate-a-long-random-value-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14
# Refresh cookie: leave COOKIE_SECURE empty → true in production, false in development.
COOKIE_SECURE=
COOKIE_SAMESITE=lax                 # lax | strict | none (none requires COOKIE_SECURE=true)
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=900
AUTH_RATE_LIMIT_PER_MINUTE=30
# Used to build links in e-mails (password reset).
FRONTEND_URL=http://localhost:8080
